{
  "scopeName": "source.clrs",
  "name": "CLRS",
  "patterns": [
    { "include": "#comment" },
    { "include": "#backtick" },
    { "include": "#import" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#number" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "match": "(▷|\\|>).*$",
      "name": "comment.line.clrs"
    },
    "backtick": {
      "match": "`",
      "name": "invalid.illegal.backtick.clrs"
    },
    "import": {
      "match": "^\\s*(import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "keyword.control.import.clrs" },
        "2": { "name": "entity.name.namespace.clrs" },
        "3": { "name": "keyword.control.import.clrs" },
        "4": { "name": "variable.other.alias.clrs" }
      }
    },
    "keyword": {
      "match": "\\b(Module|datatype|extends|for|to|downto|do|while|if|then|else|return|and|or|as)\\b",
      "name": "keyword.control.clrs"
    },
    "constant": {
      "match": "\\b(True|False|NIL)\\b|∞",
      "name": "constant.language.clrs"
    },
    "number": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.clrs"
    },
    "operator": {
      "match": "←|↔|≤|≥|≠|⌊|⌋|⌈|⌉|<-|<->|<=|>=|!=|\\|\\.|\\.\\||\\|\\^|\\^\\||\\.Inf",
      "name": "keyword.operator.clrs"
    }
  }
}
